# 0002-musb-timeval-ktime-port (k512-only, 2026-09-22, Fase 9-6a):
# port de musb_g_timer_workqueue: struct timeval + do_gettimeofday (removidas
# en Linux 5.0) -> ktime_get/ktime_ms_delta (monotonico — mas correcto para
# medir elapsed). diff_timeval_in_ms eliminado (unico caller).
# SOLO 5.12.4: el tree 4.4 usa la API vieja (ktime_ms_delta no existe ahi).
--- a/drivers/hcdrivers/musb/hcusb.c	2026-09-22 17:44:02.351143962 -0500
+++ b/drivers/hcdrivers/musb/hcusb.c	2026-09-22 17:44:02.382557457 -0500
@@ -1267,18 +1267,6 @@
 	}
 }
 
-// return millisecond
-static long diff_timeval_in_ms(struct timeval *new, struct timeval *start)
-{
-    if((new->tv_sec < start->tv_sec) ||
-            ((new->tv_sec == start->tv_sec) &&
-                (new->tv_usec < start->tv_usec)))
-        return -1;
-
-    return (new->tv_sec * 1000 + new->tv_usec / 1000) -
-        (start->tv_sec * 1000 + start->tv_usec / 1000);
-}
-
 
 static void musb_g_timer_workqueue(struct work_struct *work)
 {
@@ -1294,7 +1282,7 @@
     uint32_t musb_base = (uint32_t)musb->mregs;
     uint8_t reg;
     u8 power;
-    struct timeval cur, start;
+    ktime_t start;
     long diff_ms = 0;
     bool is_disconnect = false;
 
@@ -1314,17 +1302,17 @@
     // mdelay(20);
     mdelay(50);
 
-    do_gettimeofday(&start);
+    start = ktime_get();
 
-    // loop not more than 50ms
+    // loop not more than 50ms (9-6a port: ktime monotónico —
+    // do_gettimeofday/struct timeval fueron removidos en Linux 5.0)
     do {
         reg = *((volatile uint8_t *)(musb_base + 0x383));
         if((reg & LINE_STATE_MASK) == LINE_STATE_CHIP_K) {
             is_disconnect = true;
             break;
         }
-        do_gettimeofday(&cur);
-        diff_ms = diff_timeval_in_ms(&cur, &start);
+        diff_ms = (long)ktime_ms_delta(ktime_get(), start);
     } while((diff_ms >= 0) && (diff_ms < 50));
 
     // note: must read register before stop resume signal
