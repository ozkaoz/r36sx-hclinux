-static void hc_dma_channel_release(struct dma_channel *channel)
-{
-	struct hc_musb_dma_channel *musb_channel = channel->private_data;
-
-	channel->actual_len = 0;
-	musb_channel->start_addr = 0;
-	musb_channel->len = 0;
-
-	musb_channel->controller->used_channels &=
-		~(1 << musb_channel->idx);
-
-	channel->status = MUSB_DMA_STATUS_UNKNOWN;
-}
-
-static void configure_channel(struct dma_channel *channel,
-				u16 packet_sz, u8 mode,
-				dma_addr_t dma_addr, u32 len)
-{
-	struct hc_musb_dma_channel *musb_channel = channel->private_data;
-	struct hc_musb_dma_controller *controller = musb_channel->controller;
-	struct musb *musb = controller->private_data;
-	void __iomem *mbase = controller->base;
-	u8 bchannel = musb_channel->idx;
-	u16 csr = 0;
-
-	if (mode) {
-		csr |= 1 << MUSB_HSDMA_MODE1_SHIFT;
-		BUG_ON(len < packet_sz);
-	}
-
-	#ifdef CONFIG_MUSB_DMA_BURST_MODE // !note: tony.su debug -- 20220304
-	if(musb_channel->transmit) //TX ep
-		csr |= MUSB_HSDMA_BURSTMODE_UNSPEC
-					<< MUSB_HSDMA_BURSTMODE_SHIFT;
-	else{ // RX ep
-		csr |= MUSB_HSDMA_BURSTMODE_INCR8
-					<< MUSB_HSDMA_BURSTMODE_SHIFT;
-	}
-	#endif
-
-	csr |= (musb_channel->epnum << MUSB_HSDMA_ENDPOINT_SHIFT)
-		| (1 << MUSB_HSDMA_ENABLE_SHIFT)
-		| (1 << MUSB_HSDMA_IRQENABLE_SHIFT)
-		| (musb_channel->transmit
-				? (1 << MUSB_HSDMA_TRANSMIT_SHIFT)
-				: 0);
-
-	dev_dbg(musb->controller, "%s(csr:0x%4x) %p, pkt_sz %d, addr 0x%x, len %d, mode %d\n",
-			musb_channel->transmit ? "-->" : "<--",
-			csr,
-			channel, packet_sz, dma_addr, len, mode);
-
-	if(dma_addr % 8)
-		pr_warn(" !!!!!!!  dma_addr(0x%x) not align 8 bytes\n", dma_addr);
-
-	/* address/count */
-	musb_write_hsdma_addr(mbase, bchannel, dma_addr);
-	musb_write_hsdma_count(mbase, bchannel, len);
-
-	/* control (this should start things) */
-	musb_writew(mbase,
-		MUSB_HSDMA_CHANNEL_OFFSET(bchannel, MUSB_HSDMA_CONTROL),
-		csr);
-}
-
-static int hc_dma_channel_program(struct dma_channel *channel,
-				u16 packet_sz, u8 mode,
-				dma_addr_t dma_addr, u32 len)
-{
-	struct hc_musb_dma_channel *musb_channel = channel->private_data;
-	struct hc_musb_dma_controller *controller = musb_channel->controller;
-	struct musb *musb = controller->private_data;
-
-	dev_dbg(musb->controller, "ep%d-%s pkt_sz %d, dma_addr 0x%x length %d, mode %d\n",
-		musb_channel->epnum,
-		musb_channel->transmit ? "Tx" : "Rx",
-		packet_sz, dma_addr, len, mode);
-
-	// printk("+%c%u\n", 
-	// 		musb_channel->transmit ? 'T' : 'R',
-	// 		len);
-
-	#ifdef CONFIG_MUSB_DEBUG_PATCH_2
-	// if((len < 512)){
-	if((!musb_channel->transmit) && (len < 1024)){
-		return false;
-	}
-	#endif
-	
-	BUG_ON(channel->status == MUSB_DMA_STATUS_UNKNOWN ||
-		channel->status == MUSB_DMA_STATUS_BUSY);
-
-#if LINUX_VERSION_CODE < KERNEL_VERSION(4,17,0)
-	/* Let targets check/tweak the arguments */
-	if (musb->ops->adjust_channel_params) {
-		int ret = musb->ops->adjust_channel_params(channel,
-			packet_sz, &mode, &dma_addr, &len);
-		if (ret)
-			return ret;
-	}
-#endif
-
-	/*
-	 * The DMA engine in RTL1.8 and above cannot handle
-	 * DMA addresses that are not aligned to a 4 byte boundary.
-	 * It ends up masking the last two bits of the address
-	 * programmed in DMA_ADDR.
-	 *
-	 * Fail such DMA transfers, so that the backup PIO mode
-	 * can carry out the transfer
-	 */
-	if ((musb->hwvers >= MUSB_HWVERS_1800) && (dma_addr % 4))
-		return false;
-
-	channel->actual_len = 0;
-	musb_channel->start_addr = dma_addr;
-	musb_channel->len = len;
-	musb_channel->max_packet_sz = packet_sz;
-	channel->status = MUSB_DMA_STATUS_BUSY;
-
-	#ifdef CONFIG_MUSB_DMA_XFER_ALIGN
-	if(musb_channel->transmit){
-		#if 0
-		if(len > CONFIG_MUSB_DMA_XFER_ALIGN){
-			musb_channel->len_align = len / CONFIG_MUSB_DMA_XFER_ALIGN;
-			musb_channel->len_remain = len % CONFIG_MUSB_DMA_XFER_ALIGN;
-		}else{
-			musb_channel->len_align = len;
-			musb_channel->len_remain = 0;
-		}
-		#else
-		musb_channel->len_align = len;
-		musb_channel->len_remain = 0;
-		#endif
-	}else{
-		// mode = 1; // !note: 不管是怎么样的长度, 统统按照大于512bytes去处理
-		musb_channel->len_align = len;
-		musb_channel->len_remain = 0;
-
-	#ifdef CONFIG_MUSB_DEBUG_PATCH //!note : 丁锐提供修改建议
-		u16 *reg = ioremap(0x18850126, 2);
-		u16 reg_val = readw(reg);
-		// pr_warn("@@@ before --> 0x18850126 0x%x\n", reg_val);
-		reg_val |= (MUSB_RXCSR_DMAMODE);
-		writew(reg_val, reg);
-		iounmap(reg);
-	#endif
-	}
-
-	dev_dbg(musb->controller, "@@@ep_program-- %s len:%u, remain:%u\n", 
-						musb_channel->transmit ? "Tx" : "Rx",
-						musb_channel->len,
-						musb_channel->len_remain);
-
-	configure_channel(channel, packet_sz, mode, dma_addr, musb_channel->len_align);
-	#else
-	configure_channel(channel, packet_sz, mode, dma_addr, len);
-	#endif
-
-	return true;
-}
