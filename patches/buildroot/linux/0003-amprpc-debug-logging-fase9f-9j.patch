@@ -36,6 +36,50 @@
 #include "smbox_reg.h"
 #include "mmbox_reg.h"
 #include "amprpc.h"
+
+/* 9f: debug logging */
+static atomic_t amprpc_dbg_count = ATOMIC_INIT(0);
+#define AMPRPC_DBG_MAX 2000
+#define amprpc_dbg(fmt, ...) \
+	do { if (atomic_read(&amprpc_dbg_count) < AMPRPC_DBG_MAX) { \
+		atomic_inc(&amprpc_dbg_count); \
+		pr_info("amprpc[%d]: " fmt, atomic_read(&amprpc_dbg_count), ##__VA_ARGS__); \
+	} } while(0)
+
+#define amprpc_dbg_open(fmt, ...) \
+	do { if (atomic_read(&amprpc_dbg_count) < AMPRPC_DBG_MAX && !amprpc_is_spam_open(buf)) { \
+		atomic_inc(&amprpc_dbg_count); \
+		pr_info("amprpc[%d]: " fmt, atomic_read(&amprpc_dbg_count), ##__VA_ARGS__); \
+	} } while(0)
+
+/* 9i/9j: filtro — no logear spam de cubevol */
+static inline int amprpc_is_spam_cmd(unsigned int cmd)
+{
+	switch (cmd) {
+	case 0x4001080C: /* GET_VOLUME */
+	case 0x8001080B: /* SET_VOLUME */
+	case 0x20000822: /* SET_HDMI_MUTE */
+	case 0x40041C02: /* HDMI_TX nr=2 */
+	case 0x20001C04: /* HDMI_TX nr=4 */
+		return 1;
+	}
+	return 0;
+}
+
+/* 9j: filtrar OPEN spam de cubevol (sndC0i2so + backlight en loop) */
+static inline int amprpc_is_spam_open(const char *name)
+{
+	if (!name) return 0;
+	if (strcmp(name, "/dev/sndC0i2so") == 0) return 1;
+	if (strcmp(name, "/dev/backlight") == 0) return 1;
+	return 0;
+}
+
+#define amprpc_dbg_ioctl(fmt, ...) \
+	do { if (atomic_read(&amprpc_dbg_count) < AMPRPC_DBG_MAX && !amprpc_is_spam_cmd(cmd)) { \
+		atomic_inc(&amprpc_dbg_count); \
+		pr_info("amprpc[%d]: " fmt, atomic_read(&amprpc_dbg_count), ##__VA_ARGS__); \
+	} } while(0)
