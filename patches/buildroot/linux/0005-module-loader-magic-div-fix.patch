--- a/kernel/module.c
+++ b/kernel/module.c
@@ -494,12 +494,34 @@
 {
 	struct find_symbol_arg *fsa = data;
 	struct kernel_symbol *sym;
+	size_t esz = sizeof(struct kernel_symbol);
 
-	sym = bsearch(fsa->name, syms->start, syms->stop - syms->start,
-			sizeof(struct kernel_symbol), cmp_name);
+	/*
+	 * r36sx 9-6c: gcc Codescape 6.3.0 (mips32) miscompiles every constant
+	 * division by 12 (sizeof(struct kernel_symbol)): it emits the magic
+	 * sequence "((n >> 2) * 0xAAAAAAAB)" taking the LOW 32 bits of the
+	 * product (mul) instead of the required mult+mfhi (high 32 bits).
+	 * That low half equals n/12 only when (n >> 2) is a multiple of 3,
+	 * i.e. when the operand is a multiple of 12.  Pointer subtraction of
+	 * kernel_symbol pointers is ALSO such a division.  The vendor
+	 * hcdrivers inject legacy 8-byte ksymtab entries (no namespace
+	 * field: get_adc_default_val_for_check, adc; rtw_radiotap_fixup,
+	 * hc-p2p), leaving __ksymtab size % 12 == 8, so the pointer
+	 * difference comes out as ~0x55556348 instead of 3570 and bsearch
+	 * walks far outside the array (deterministic OOPS in cmp_name ->
+	 * resolve_symbol:1411 on every insmod of modules with non-GPL
+	 * imports).  Workaround: subtract the pointers as plain integers
+	 * (bytes) and divide through a runtime variable behind an asm
+	 * barrier, which blocks const-propagation and forces a real divu.
+	 */
+	asm("" : "+r"(esz));	/* block const-propagation -> real divu */
+	sym = bsearch(fsa->name, syms->start,
+		      ((size_t)syms->stop - (size_t)syms->start) / esz,
+		      esz, cmp_name);
 
 	if (sym != NULL && check_exported_symbol(syms, owner,
-						 sym - syms->start, data))
+						 ((size_t)sym - (size_t)syms->start) / esz,
+						 data))
 		return true;
 
 	return false;
