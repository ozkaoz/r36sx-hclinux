# Kernel config fragment para r36sx-v26 (board-specific kernel config deltas)
# Aplicado por Buildroot via BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES.
#
# Fase 5 — initramfs del desarrollador (extraído del uImage stock) embebido:
# CONFIG_INITRAMFS_SOURCE apunta a rootfs-dev.cpio (desde rootfs-overlay).
# BR2_TARGET_ROOTFS_INITRAMFS desactivado (Buildroot no sobreescribe la fuente).
#
# Iteración 6w: RD_* off — forense: el kernel de FÁBRICA embebe el cpio CRUDO.
# Iteración 6x: drivers vendor baseline COMPLETOS (GE/HWSPINLOCK probados REQUERIDOS
# por el menú: 6w sin GE = batería sin menú; 6x con GE = menú completo).
#
# Iteración 7c (lean-fábrica): tras el PHYSICAL PASS 6x, defectos funcionales:
# audio muerto en TODO (juegos/música/video), video sin imagen, salida de cores
# colgada (pantalla crema). Diff dmesg fábrica↔nuestro muestra drivers EXTRAS
# nuestros que la fábrica NO tiene: i2c-dev, IR NEC, ubi/watchdog, squashfs,
# bridge. Sospechoso principal: HC_I2C (controlador compartido con el AVP que
# configura el códec de audio). Se remueven los extras con evidencia de no-uso
# (fds diag6x: nadie abre i2c/ir/watchdog/nand/toe; panel es MIPI-DSI, no LVDS):
#   REMOVE: HC_I2C, HC_IRC, HC_WDT, HC_NAND, HC_TOE, HC_LVDS
#   MANTENER: HC_GE, HC_HWSPINLOCK (requeridos por el menú — probado 6w vs 6x)
CONFIG_CHECK_ADC=y
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# Fase 9-3 (kernel 5.12.4): RD_ZSTD no existe en 4.4 pero es default-y en 5.12
# (init/Kconfig) y su INITRAMFS_COMPRESSION_ZSTD rompia el build (requiere host zstd:
# "ZSTD usr/initramfs_inc_data / zstd: not found"). Misma politica 6w: cpio CRUDO.
# En builds 4.4 estas lineas son inertes (merge_config las salta: simbolo inexistente).
# CONFIG_RD_ZSTD is not set
# CONFIG_INITRAMFS_COMPRESSION_ZSTD is not set
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# Fase 8a: rootfs 100% PROPIO (Buildroot userland + overlay minimo + hcdaemon de fabrica)
CONFIG_INITRAMFS_SOURCE="/home/dafunknoise/work/r36sx-hclinux/artifacts/r36sx-v26/rootfs-own.cpio"
# --- 7c lean-fábrica: extras vs fábrica removidos (evidencia: dmesg diff + fds diag6x) ---
# CONFIG_HC_I2C is not set
# CONFIG_HC_IRC is not set
# CONFIG_HC_WDT is not set
# CONFIG_HC_NAND is not set
# CONFIG_HC_TOE is not set
# CONFIG_HC_LVDS is not set
# --- 7e (post-diag8-diff): la fábrica NUNCA hardware-inicializa los bloques UART
# --- (sus uarts van por el driver vendor ttyHC; el 8250 solo imprime banner sin puertos).
# --- Nuestro of_serial SÍ probea ttyS0/ttyS1@18818300/18818600 y ESCRIBE sus registros
# --- (dmesg + iomem "serial") — posible interferencia con periféricos compartidos del AVP.
# --- SERIAL_8250 no se puede apagar (select del Kconfig de la máquina MIPS); la perilla
# --- quirúrgica es SERIAL_OF_PLATFORM (quien reclama los nodos DTB). Inittab usa getty
# --- en console (no ttyS) → seguro.
# CONFIG_SERIAL_OF_PLATFORM is not set
# CONFIG_HC_P2P is not set
