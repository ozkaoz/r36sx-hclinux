# Kernel config fragment r36sx-v26-k512 — deltas SOLO para kernel 5.12.4 (Fase 9-3)
# Se aplica ENCIMA de r36sx-v26.config.fragment (base compartida con 4.4.186):
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES del defconfig k512 lista AMBOS archivos.
#
# 9-6a (2026-09-22): MUSB + GADGET. Port 9102 (timeval->ktime) + port 9103 (MTP/PTP/
# AOA/audio_source desde el patch vendor 0024 que solo existia en el set 4.4).
# DUAL_ROLE (no HOST): el usb_mode.sh del stack escribe 'peripheral' al sysfs
# mode del musb para USB Mode (MTP) — con HOST-only el write crasheaba la consola
# (reinicio fisico, test 9-6a-t1). El musb 5.12 mainline ya tiene mode_show/store
# (musb_core.c:1894) — solo requiere DUAL_ROLE=y. Set gadget = 4.4 known-good:
# GADGET + LIBCOMPOSITE=m + CONFIGFS=m. USB_F_MTP/F_PTP=m DIRECTOS (tristates
# hidden del 9103): el load_mtp_stack del usb_mode.sh exige los modulos VISIBLES
# en /proc/modules — los wrappers bool USB_CONFIGFS_F_* forzarian =y via select
# y el script los daria por "unavailable". MASS_STORAGE=m = modo 'run' del stack
# (en 4.4 venia de un .ko out-of-tree en modules/; en 5.12 lo tenemos in-tree).
CONFIG_HC_MUSB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_F_MTP=y
# 9-6e v6 (2026-09-23): CDC-NCM en vez de RNDIS. Windows 10/11 DEPRECO el driver
# RNDIS (usb8023) — por eso seguia matcheando CDC-ACM serial (COM7) aun con MS OS
# Descriptors. CDC-NCM (class 02/0D/00) = soporte NATIVO en Windows 7+ sin drivers
# especiales. f_ncm.c ya existe en el tree. RNDIS queda como fallback (no usado).
# NOTA: el interrupt EP del gadget = el sospechoso de la pantalla azul — NCM
# tambien lo usa para notificaciones; si el azul persiste con NCM = debug kernel.
CONFIG_USB_CONFIGFS_NCM=y
# 9-6e v13 (2026-09-24): USB Serial (CDC-ACM) — shell via COM port.
# El AVP firmware reacciona al CDC-NCM con overlay azul (probado exhaustivamente:
# GE reset, drcoff, fb keepalive, interrupt EP PIO, todo fallo). CDC-ACM es una
# clase USB DIFERENTE (modem, no network) — el AVP probablemente no la detecta.
# No crea netdev, no usa u_ether. Shell directo via /dev/ttyGS0 + PuTTY en el PC.
CONFIG_USB_CONFIGFS_ACM=y
# 9-6e v16 (2026-09-24): CDC-ECM (subclass 06) — misma familia que ACM (probada
# SIN pantalla azul) pero con netdev. Pasa a default del dispatcher net_mode.sh
# (ncm.mode sigue seleccionando NCM como fallback). Kernel 7d87d15c compilado;
# deploy + test fisico PENDIENTES (ver docs/experiments/2026-09-24_usb-networking-blue-overlay.md).
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_F_PTP=y

# MMC/SD (9-4 post-physical-evidence fix, 2026-09-22): el base vendor 5.12.4 NO trae
# MMC (sus productos no usan SD) -> /dev/mmcblk0p1 jamas aparece -> S99app se cuelga
# en wait_for_media_ready() (bucle infinito sin timeout) -> logo congelado, cero
# writes a SD (evidencia: primer boot fisico 5.12.4). Replica el set del 4.4 known-good:
# DTB: compatible "hichip,dw-mshc" (DesignWare) + HC_SDIO (glue hcdrivers).
# MMC_BLOCK_BOUNCE no existe en 5.12 (removido mainline) — omitido.
CONFIG_HC_SDIO=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y

# Familia HC faltante (9-4 gap audit, 2026-09-22): el base vendor 5.12.4 deja en default-n
# familias enteras que el 4.4 known-good trae prendidas (sus productos difieren).
# Replicar el set known-good EXACTO (diff HC_* 4.4 vs k512):
#   HC_ADC: gate de CHECK_ADC (bateria; el CHECK_ADC=y del fragment compartido era
#           INALCANZABLE sin este gate — hcdrivers/adc/Kconfig "if HC_ADC")
#   HC_INPUT/HC_INPUT_GPIO/HC_GPIO_KEY: BOTONES (sin estos el menu no navega)
#   HC_SPI: maestro SPI (4.4 lo tiene; k512 tenia solo HC_SPI_SF sin maestro)
#   (HC_MUSB/HC_USB_IUM: fuera deliberadamente — port musb = 9-6)
CONFIG_HC_ADC=y
CONFIG_KEY_ADC=y
CONFIG_HC_INPUT=y
CONFIG_HC_INPUT_GPIO=y
CONFIG_HC_GPIO_KEY=y
CONFIG_HC_SPI=y

# 9-6e (2026-09-24): PPP/SLIP sobre CDC-ACM — RETENIDO EXPERIMENTAL.
# Refutado fisicamente: la sesion PPP TAMBIEN dispara el overlay azul del AVP
# (networking ACTIVO en general lo dispara; ACM puro sin pppd no). Ver ADR-015
# y docs/experiments/2026-09-24_9-6e-ppp-slip.md. El kernel desplegado e07844bd
# incluye estas opciones; inofensivas sin uso. Produccion: NCM.
CONFIG_PPP=y
CONFIG_PPP_ASYNC=y
CONFIG_PPP_DEFLATE=y
CONFIG_SLIP=y


# 9-6d F2 (2026-09-25): USB network host-side drivers — internet via celular
# tethering. La consola actua como USB HOST, el telefono como gadget (RNDIS/CDC).
# Compilados como modulos (.ko) — el module loader esta ARREGLADO (9-6c PASS).
# insmod cdc_ether.ko + rndis_host.ko → udhcpc → internet del telefono.
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m

# 9-6f (2026-09-26): ADB via FunctionFS — shell/debug sin overlay azul
# FunctionFS (clase 0xFF vendor-specific, como MTP que NO dispara overlay).
# Gadgets creados via configfs igual que NCM/MTP pero con ffs.
CONFIG_USB_FUNCTIONFS=y
CONFIG_USB_CONFIGFS_F_FS=y
