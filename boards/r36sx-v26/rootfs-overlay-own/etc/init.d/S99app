#!/bin/sh
# S99app — TreeFrogUI launcher (treefrog/ paths, no cubegm)
# Clean rewrite: no bind mount, no cubegm references.
# Based on the proven working S99app from kernel e45547a2.
# Syntax: verified with sh -n.

MNTDIR=""
wait_for_media_ready()
{
	if [ -e /dev/mmcblk0p1 ] && ! grep -q "^/dev/mmcblk0p1 " /proc/mounts ; then
		mkdir -p /media/mmc
		mount -t vfat -o iocharset=utf8 /dev/mmcblk0p1 /media/mmc 2>/dev/null
	fi
	while true
	do
		for subdir in $(ls /media); do
			if [ -e /media/$subdir/treefrog/zhijack.sh ] ; then
				MNTDIR=$subdir
				return
			fi
		done
		sleep 0.1
	done
}

launch_treefrog()
{
	export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/mnt/sdcard/treefrog/lib:/mnt/sdcard/treefrog/usr/lib
	/mnt/sdcard/treefrog/zhijack.sh &
}

wait_for_media_ready

mount --bind /media/${MNTDIR} /mnt/sdcard

# rootfs: montar lib/usr/bin/sbin/etc desde rootfs/ de la SD
if [ -d /media/${MNTDIR}/rootfs ] ; then
	mount --bind /media/${MNTDIR}/rootfs/lib /lib
	mount --bind /media/${MNTDIR}/rootfs/usr /usr
	mount --bind /media/${MNTDIR}/rootfs/bin /bin
	mount --bind /media/${MNTDIR}/rootfs/sbin /sbin
	mount --bind /media/${MNTDIR}/rootfs/etc /etc
	mount --bind /media/${MNTDIR}/rootfs/hcdemo_files /hcdemo_files
else
	mount --bind /media/${MNTDIR}/treefrog/lib /lib
	mount --bind /media/${MNTDIR}/treefrog/usr/lib /usr/lib
fi

# swap: la R36SX (~60MB RAM) necesita 128MB de swap para TreeFrogUI
memsize=$(free | grep Mem | awk '{print $2}')
if [ $memsize -le 128000 ] ; then
	if [ ! -f /mnt/sdcard/treefrog/pagefile.sys ] ; then
		echo "Creating pagefile.sys ..."
		fallocate -l 128M /mnt/sdcard/treefrog/pagefile.sys
		mkswap /mnt/sdcard/treefrog/pagefile.sys
	fi
	if [ -f /mnt/sdcard/treefrog/pagefile.sys ] ; then
		swapon /mnt/sdcard/treefrog/pagefile.sys
		launch_treefrog
	fi
else
	launch_treefrog
fi
